# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="233000000000"
MAINTENANCE_MODE="false"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (Prisma optional)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Manuel Data Plug <noreply@manueldataplug.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payments (future)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""

# Moolre (never expose secret/private keys with NEXT_PUBLIC_)
# Public key is optional — private/secret key is enough for MoMo collection
MOOLRE_MODE="live"
MOOLRE_USERNAME=""
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_SECRET_KEY=""
MOOLRE_PRIVATE_API_KEY=""
MOOLRE_PUBLIC_API_KEY=""
MOOLRE_PAYMENT_CALLBACK_URL="http://localhost:3000/api/payments/moolre/callback"
